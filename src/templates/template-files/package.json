{
  "name": "{{packageName}}",
  "version": "1.0.0",
  "license": "MPL-2.0",
  "description": "{{description}}",
  "generator": "{{generator}}",
  "browser": "dist/openmrs-esm-{{kebabCase projectName}}.js",
  "main": "src/index.ts",
  "source": true,
  "scripts": {
    "start": "openmrs develop",
    "build": "{{buildTool}} --mode production",
    "build:development": "{{buildTool}} --mode development",
    "analyze": "{{buildTool}} --mode=production --env.analyze=true",
    "serve": "{{buildTool}} serve --mode=development",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest watch",
    "coverage": "vitest run --coverage --passWithNoTests",
    "typescript": "tsc",
    "lint": "eslint src",
    "extract-translations": "i18next 'src/**/*.component.tsx' 'src/**/*.extension.tsx' 'src/**/*.modal.tsx' 'src/**/*.workspace.tsx' 'src/index.ts' --config ./tools/i18next-parser.config.js",
    "prettier": "prettier --config prettier.config.js --write \"src/**/*.{ts,tsx,css,scss}\""{{#unless isMonorepo}},
    "postinstall": "husky install"{{/unless}}
  },
  "keywords": [
    "openmrs",
    "microfrontends"
  ],
  "browserslist": [
    "extends browserslist-config-openmrs"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openmrs/openmrs-esm-{{projectName}}.git"
  },
  "bugs": {
    "url": "https://github.com/openmrs/openmrs-esm-{{projectName}}/issues"
  },
  "homepage": "https://github.com/openmrs/openmrs-esm-{{projectName}}#readme",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "src"
  ],
  "dependencies": {
    "@carbon/icons-react": "^11.68.0",
    "@carbon/react": "^1.83.0"
  },
  "peerDependencies": {
    "@carbon/icons-react": "11.x",
    "@carbon/react": "1.x",
    "@openmrs/esm-framework": "*",
    "dayjs": "1.x",
    "i18next": "25.x",
    "react": "18.x",
    "react-dom": "18.x",
    "react-i18next": "16.x",
    "react-is": "18.x",
    "react-router-dom": "6.x",
    "rxjs": "6.x",
    "sass": "1.x",
    "single-spa": "6.x",
    "swr": "2.x"
  },
  "devDependencies": {
    "openmrs": "next",
    "@openmrs/esm-framework": "next",
    "@openmrs/eslint-config": "^2.0.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.5.2",
    "@vitest/coverage-v8": "^4.1.2",
    "dayjs": "^1.11.13",
    "eslint": "^9.39.0",
{{#unless isMonorepo}}    "husky": "^9.0.11",
{{/unless}}    "i18next": "^25.0.0",
    "i18next-parser": "^9.0.1",
    "identity-obj-proxy": "^3.0.0",
    "jsdom": "^28.0.0",
{{#unless isMonorepo}}    "lint-staged": "^15.2.2",
{{/unless}}    "prettier": "^3.2.5",
    "react": "^18.1.0",
    "react-dom": "^18.1.0",
    "react-i18next": "^16.0.0",
    "react-is": "^18.3.1",
    "react-router-dom": "^6.3.0",
    "rxjs": "^6.5.3",
    "sass": "^1.33.0",
    "single-spa": "^6.0.0",
    "swr": "^2.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.2",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0"
  },
{{#unless isMonorepo}}  "lint-staged": {
    "*.{ts,tsx}": "eslint --cache --fix --max-warnings 0",
    "*.{css,scss,ts,tsx}": "prettier --write --list-different"
  },
{{/unless}}  "packageManager": "yarn@4.10.3"
}
