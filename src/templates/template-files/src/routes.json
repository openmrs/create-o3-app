{
  "$schema": "https://json.openmrs.org/routes.schema.json",
{{#if backendDependencies}}
  "backendDependencies": {
{{#each backendDependencies}}
    "{{{this.name}}}": "{{{this.version}}}"{{#unless @last}},{{/unless}}
{{/each}}
  },
{{/if}}
  "pages": [
{{#each routes}}
    {
      "route": "{{#if (startsWith this.path '/')}}{{substring this.path 1}}{{else}}{{this.path}}{{/if}}",
      "component": "root"{{#if this.online}},
      "online": {{this.online}}{{/if}}{{#if this.offline}},
      "offline": {{this.offline}}{{/if}}
    }{{#unless @last}},{{/unless}}
{{/each}}
  ],
  "extensions": [
{{#each extensions}}
    {
      "name": "{{this.name}}",
      "slot": "{{this.slot}}",
      "component": "{{camelCase this.componentName}}"{{#if this.online}},
      "online": {{this.online}}{{/if}}{{#if this.offline}},
      "offline": {{this.offline}}{{/if}}{{#if this.order}},
      "order": {{this.order}}{{/if}}{{#if this.featureFlag}},
      "featureFlag": "{{this.featureFlag}}"{{/if}}{{#if this.meta}},
      "meta": {{{json this.meta}}}{{/if}}
    }{{#unless @last}},{{/unless}}
{{/each}}
  ]{{#if modals}},
  "modals": [
{{#each modals}}
    {
      "name": "{{this.name}}",
      "component": "{{camelCase this.componentName}}"
    }{{#unless @last}},{{/unless}}
{{/each}}
  ]{{/if}}{{#if workspaces}},
  "workspaceGroups2": [
    {
      "name": "{{kebabCase projectName}}-workspace-group",
      "scopePattern": "{{workspaceScopePattern}}"
    }
  ],
  "workspaceWindows2": [
    {
      "name": "{{kebabCase projectName}}-workspace-window",
      "group": "{{kebabCase projectName}}-workspace-group"
    }
  ],
  "workspaces2": [
{{#each workspaces}}
    {
      "name": "{{this.name}}",
      "component": "{{camelCase this.componentName}}",
      "window": "{{kebabCase ../projectName}}-workspace-window"
    }{{#unless @last}},{{/unless}}
{{/each}}
  ]{{/if}}{{#if featureFlags}},
  "featureFlags": [
{{#each featureFlags}}
    {
      "flagName": "{{this.name}}",
      "label": {{{json this.label}}},
      "description": {{{json this.description}}}
    }{{#unless @last}},{{/unless}}
{{/each}}
  ]{{/if}}
}
